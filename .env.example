# Sao chép file này thành .env rồi chỉnh nếu cần. KHÔNG commit file .env.

# Mặc định dùng SQLite (không cần cài gì). Để dùng PostgreSQL, bỏ dấu # dòng dưới
# và chạy: backend/.venv/bin/pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/affiliate

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=5000

# Phase 3+ (chưa dùng ở Phase 1) — khóa API của riêng bạn, có thể phát sinh chi phí:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
